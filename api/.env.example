# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3001
HOST=127.0.0.1
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/erm_actually
# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
# Seconds a login token stays valid (default 43200 = 12 hours)
JWT_TTL_SECONDS=43200

# --- URLs ---
# Public origin of this API (verification emails link here)
API_PUBLIC_URL=https://api.example.com
# Public origin of the React app. Verification links redirect here; reset emails link here.
WEB_APP_URL=https://example.com
# Browser origins allowed to call the API directly (comma-separated). Not needed when the web app proxies /api.
CORS_ORIGINS=https://example.com

# --- Email ---
# smtp = send real email (required for the hosted app). console = print emails to the API log (local dev only).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Erm Actually <no-reply@example.com>
# Contact-form messages are emailed here (optional; they are stored in MongoDB regardless)
CONTACT_TO=
