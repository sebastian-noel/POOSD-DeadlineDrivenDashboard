# Copy to .env.local to override. Both values are optional.

# Development: where `npm run dev` forwards /api requests (your local API).
API_PROXY_TARGET=http://localhost:4000

# Production: absolute origin of the API, only if it is NOT served under the same domain as the app
# (leave empty when nginx proxies /api to the API on the same domain).
VITE_API_URL=
